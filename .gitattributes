# Files that end up inside Microsoft 365 skill packages must stay LF: a CRLF shebang
# fails in the Linux sandbox and SKILL.md must be UTF-8 without BOM.
shared/skills/m365-skill-pack/m365/** text eol=lf
shared/skills/m365-skill-pack/scripts/** text eol=lf

# Shell scripts run under bash/sh on Linux (cloud sessions, CI) and under Git for Windows' sh.
# With core.autocrlf=true a CRLF checkout breaks them ("set -uo pipefail\r"), e.g.
# .claude/hooks/session-start.sh, which then fails silently and leaves the git hooks off.
*.sh text eol=lf
